#!/usr/bin/env bash
#
# Painel do agendador do AmaView numa linha só.
#
#   amaview              situação (timers, últimas execuções, frescor do dado, blocos, fumaça, ar, estações)
#   amaview instalar     clona/atualiza, instala as unidades e liga os timers, os blocos, a fumaça, o ar e as estações
#   amaview certificado  HTTPS dos blocos (Let's Encrypt; uma vez, renova sozinho)
#   amaview renovar-ip   emite/renova o certificado do IP (o timer chama; manual também serve)
#   amaview token        grava o token (pede na tela, sem eco)
#   amaview chave F      grava a chave da qualidade do ar (F = purpleair | openaq; sem eco; testa antes)
#   amaview chave F remover   apaga a chave (a fonte sai na próxima rodada)
#   amaview disparar [w] dispara um ciclo agora (chuva.yml; ou sondagem.yml)
#   amaview logs [n]     últimas execuções
#   amaview parar        desliga os timers
#   amaview remover      desinstala tudo (menos o token)
#
# O agendamento do GitHub Actions não é confiável — medido: 135 min de
# intervalo médio quando o pedido era 15. Esta máquina é o relógio de verdade.
set -uo pipefail

REPO_URL="https://github.com/helvecioneto/AmaView-dados"
DESTINO="/opt/amaview"
# Uma unidade por workflow. A sondagem entrou depois de passar 12 h sem
# atualizar: dependia só do `schedule` do GitHub, que em 21/09/2026 entregou
# 1 de 2 horários com ~4 h de atraso.
UNIDADES="amaview-chuva amaview-sondagem"
TOKEN="/etc/amaview/token"
# Blocos do GOES-19 (agendador/blocos): o nome resolve para o IP desta máquina
# pelo sslip.io, e é com ele que o certificado sai.
BLOCOS_IP="147.15.84.134"
BLOCOS_NOME="147-15-84-134.sslip.io"
BLOCOS_SITE="/etc/nginx/sites-available/amaview-blocos"
# Certificado do próprio IP (lego; o certbot 2.9 do Ubuntu não emite para IP).
# É o endereço que o AmaView usa: o sslip.io é bloqueado por filtros de DNS.
LEGO_VERSAO="5.5.2"
LEGO_SHA256="15b14ec2ab14fde69cc8396eb0204c5ce4327e31a486953225a6059b26db3e8c"
LEGO_PASTA="/etc/amaview/lego"
CERT_IP="$LEGO_PASTA/certificates/$BLOCOS_IP.crt"

verde() { printf '\033[32m%s\033[0m\n' "$*"; }
vermelho() { printf '\033[31m%s\033[0m\n' "$*"; }
amarelo() { printf '\033[33m%s\033[0m\n' "$*"; }
titulo() { printf '\n\033[1m%s\033[0m\n' "$*"; }

timers() { for u in $UNIDADES; do printf '%s.timer ' "$u"; done; }
filtro_journal() { for u in $UNIDADES; do printf -- '-u %s ' "$u"; done; }

# `restart`, e não só `--now`: um timer já ativo não relê a unidade editada.
ligar_timers() {
  for t in $(timers); do
    sudo systemctl enable "$t" >/dev/null 2>&1 && sudo systemctl restart "$t" && verde "  $t ligado"
  done
}

instalar() {
  titulo "Instalando"
  sudo mkdir -p "$DESTINO" /etc/amaview
  if [ -d "$DESTINO/.git" ]; then
    sudo git -C "$DESTINO" pull -q && echo "  repositório atualizado"
  else
    sudo git clone -q "$REPO_URL" "$DESTINO" && echo "  repositório clonado"
  fi
  sudo chmod +x "$DESTINO/agendador/disparar.py"
  for u in $UNIDADES; do
    sudo cp "$DESTINO/agendador/$u.service" "$DESTINO/agendador/$u.timer" /etc/systemd/system/
  done
  sudo systemctl daemon-reload
  echo "  unidades instaladas"

  # Mantém este próprio script em dia junto com o resto.
  sudo install -m 755 "$DESTINO/agendador/amaview" /usr/local/bin/amaview 2>/dev/null \
    && echo "  'amaview' disponível em /usr/local/bin"

  instalar_fumaca
  instalar_ar
  instalar_meteo
  instalar_blocos

  if [ ! -s "$TOKEN" ]; then
    amarelo "  token ausente — rode: amaview token"
    return 0
  fi
  ligar_timers
}

# Site do nginx: sempre a porta 80; a 443 só com o certificado já emitido.
gerar_site_blocos() {
  local src="$DESTINO/agendador/blocos"
  sudo install -m 644 "$src/nginx-locais.conf" /etc/nginx/snippets/amaview-blocos.conf
  sudo install -m 644 "$DESTINO/agendador/fumaca/nginx-locais.conf" /etc/nginx/snippets/amaview-fumaca.conf
  sudo install -m 644 "$DESTINO/agendador/ar/nginx-locais.conf" /etc/nginx/snippets/amaview-ar.conf
  sudo install -m 644 "$DESTINO/agendador/meteo/nginx-locais.conf" /etc/nginx/snippets/amaview-meteo.conf
  {
    cat "$src/nginx-site.conf"
    if sudo test -s "/etc/letsencrypt/live/$BLOCOS_NOME/fullchain.pem"; then
      cat "$src/nginx-site-tls.conf"
    fi
    if sudo test -s "$CERT_IP"; then
      cat "$src/nginx-site-tls-ip.conf"
    fi
  } | sed "s/@NOME@/$BLOCOS_NOME/g; s/@IP@/$BLOCOS_IP/g" | sudo tee "$BLOCOS_SITE" >/dev/null
  sudo ln -sf "$BLOCOS_SITE" /etc/nginx/sites-enabled/amaview-blocos
  if sudo nginx -t -q; then
    sudo systemctl reload nginx && echo "  nginx: site dos blocos em dia"
  else
    vermelho "  nginx recusou a configuração — nada recarregado"
    return 1
  fi
}

instalar_blocos() {
  titulo "Blocos do GOES-19"
  getent passwd amaview-blocos >/dev/null \
    || sudo useradd --system --no-create-home --shell /usr/sbin/nologin amaview-blocos
  dpkg -s libturbojpeg >/dev/null 2>&1 \
    || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libturbojpeg >/dev/null
  sudo cp "$DESTINO/agendador/blocos/amaview-blocos.service" /etc/systemd/system/
  sudo systemctl daemon-reload
  sudo systemctl enable amaview-blocos >/dev/null 2>&1
  # `restart`: o serviço relê o código que o `git pull` acabou de trazer.
  sudo systemctl restart amaview-blocos && verde "  amaview-blocos no ar"
  gerar_site_blocos
  instalar_certificado_ip
}

# lego com versão e checksum fixos: baixar binário da internet para rodar como
# root só depois de conferir o hash.
instalar_lego() {
  if command -v lego >/dev/null && lego --version 2>/dev/null | grep -q "$LEGO_VERSAO"; then return 0; fi
  local tmp arq
  tmp="$(mktemp -d)"
  arq="lego_v${LEGO_VERSAO}_linux_arm64.tar.gz"
  curl -fsSL -o "$tmp/$arq" "https://github.com/go-acme/lego/releases/download/v$LEGO_VERSAO/$arq" || { vermelho "  não consegui baixar o lego"; rm -rf "$tmp"; return 1; }
  if ! echo "$LEGO_SHA256  $tmp/$arq" | sha256sum -c --quiet; then
    vermelho "  checksum do lego não confere — nada instalado"; rm -rf "$tmp"; return 1
  fi
  tar -xzf "$tmp/$arq" -C "$tmp" lego && sudo install -m 755 "$tmp/lego" /usr/local/bin/lego && echo "  lego $LEGO_VERSAO instalado"
  rm -rf "$tmp"
}

instalar_certificado_ip() {
  titulo "Certificado do IP ($BLOCOS_IP)"
  instalar_lego || return 1
  sudo cp "$DESTINO/agendador/amaview-certificado-ip.service" "$DESTINO/agendador/amaview-certificado-ip.timer" /etc/systemd/system/
  sudo systemctl daemon-reload
  sudo systemctl enable amaview-certificado-ip.timer >/dev/null 2>&1
  sudo systemctl restart amaview-certificado-ip.timer && verde "  renovação automática ligada (2×/dia)"
  if ! sudo test -s "$CERT_IP"; then
    echo "  emitindo o primeiro certificado…"
    renovar_ip
  fi
}

# Emite ou renova (o lego decide: só com metade da validade gasta) e refaz o
# site do nginx, que ganha o bloco 443 do IP na primeira vez.
renovar_ip() {
  sudo mkdir -p "$LEGO_PASTA" && sudo chmod 700 "$LEGO_PASTA"
  if sudo lego --log.format text run --path "$LEGO_PASTA" --accept-tos \
      --domains "$BLOCOS_IP" --profile shortlived \
      --http --http.webroot /var/www/html; then
    gerar_site_blocos
  else
    vermelho "  a Let's Encrypt recusou ou não respondeu — o certificado atual continua"
    return 1
  fi
}

# Fumaça do GOES-19 (agendador/fumaca): um timer independente do token — lê o
# balde público da NOAA e escreve em /var/cache/amaview-fumaca, que o nginx serve.
instalar_fumaca() {
  titulo "Fumaça do GOES-19"
  getent passwd amaview-fumaca >/dev/null \
    || sudo useradd --system --no-create-home --shell /usr/sbin/nologin amaview-fumaca
  local falta=""
  for p in python3-numpy python3-h5py python3-shapely; do
    dpkg -s "$p" >/dev/null 2>&1 || falta="$falta $p"
  done
  [ -z "$falta" ] || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $falta >/dev/null
  sudo cp "$DESTINO/agendador/fumaca/amaview-fumaca.service" "$DESTINO/agendador/fumaca/amaview-fumaca.timer" /etc/systemd/system/
  sudo systemctl daemon-reload
  sudo systemctl enable amaview-fumaca.timer >/dev/null 2>&1
  sudo systemctl restart amaview-fumaca.timer && verde "  amaview-fumaca.timer ligado (a cada 2 min)"
}

# Qualidade do ar (agendador/ar): outro timer independente do token — lê as
# APIs públicas da UFAC, da RedeAr, da AirGradient, do MonitorAr e do
# Open-Meteo (e, com chave, da PurpleAir e da OpenAQ: `amaview chave`) e
# escreve em /var/cache/amaview-ar, que o nginx serve. Só Python da biblioteca padrão.
instalar_ar() {
  titulo "Qualidade do ar"
  getent passwd amaview-ar >/dev/null \
    || sudo useradd --system --no-create-home --shell /usr/sbin/nologin amaview-ar
  sudo cp "$DESTINO/agendador/ar/amaview-ar.service" "$DESTINO/agendador/ar/amaview-ar.timer" /etc/systemd/system/
  sudo systemctl daemon-reload
  sudo systemctl enable amaview-ar.timer >/dev/null 2>&1
  sudo systemctl restart amaview-ar.timer && verde "  amaview-ar.timer ligado (a cada 5 min)"
}

situacao_ar() {
  titulo "Qualidade do ar"
  systemctl is-active --quiet amaview-ar.timer \
    && verde "  timer ligado" || vermelho "  timer desligado — rode: amaview instalar"
  python3 - <<'PY' 2>/dev/null || amarelo "  sem pontos.json ainda em /var/cache/amaview-ar"
import json
from datetime import datetime, timezone
p = json.load(open("/var/cache/amaview-ar/ar/v1/pontos.json"))
agora = datetime.now(timezone.utc).timestamp() * 1000
s = p["sensores"]["lista"]
por = {}
for x in s:
    f = x.get("fonte", "ufac")
    t, v = por.get(f, (0, 0))
    por[f] = (t + 1, v + (agora - x["ult"]["t"] <= 48 * 3600e3))
vivos = sum(v for _, v in por.values())
print(f"  {len(s)} sensores de baixo custo, {vivos} com leitura nas últimas 48 h:")
for f, (t, v) in sorted(por.items(), key=lambda kv: -kv[1][1]):
    print(f"    {f:12} {v:4} vivos de {t}")
e = p["estacoes"]["lista"]
print(f"  {len(e)} estações do MonitorAr, {sum(1 for x in e if x['ult'] and agora - x['ult'] <= 48 * 3600e3)} com dado nas últimas 48 h")
print("  fontes:")
for nome, f in p["fontes"].items():
    if f.get("nota") == "sem chave":
        print(f"    {nome:12} inativa (sem chave — rode: sudo amaview chave {nome})")
        continue
    quando = f"ok {(agora - f['em']) / 60e3:.0f} min atrás" if f.get("em") else "nunca respondeu"
    extra = []
    if f.get("nota"):
        extra.append(f["nota"])
    if f.get("saldo") is not None:
        extra.append(f"saldo {f['saldo']:,} pontos".replace(",", "."))
    if f.get("gastoDia") is not None:
        extra.append(f"~{f['gastoDia']:,} pontos/dia".replace(",", "."))
    if f.get("erro"):
        extra.append(f"erro: {f['erro']}")
    print(f"    {nome:12} {quando}" + (" · " + " · ".join(extra) if extra else ""))
PY
  journalctl -u amaview-ar -n 1 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
  echo "  em disco: $(du -sh /var/cache/amaview-ar 2>/dev/null | cut -f1)"
}

# Estações meteorológicas (agendador/meteo): timer independente do token — lê o
# WIS2 do INMET e o METAR da NOAA AWC e escreve em /var/cache/amaview-meteo,
# que o nginx serve. Só Python da biblioteca padrão.
instalar_meteo() {
  titulo "Estações meteorológicas"
  getent passwd amaview-meteo >/dev/null \
    || sudo useradd --system --no-create-home --shell /usr/sbin/nologin amaview-meteo
  sudo cp "$DESTINO/agendador/meteo/amaview-meteo.service" "$DESTINO/agendador/meteo/amaview-meteo.timer" /etc/systemd/system/
  sudo systemctl daemon-reload
  sudo systemctl enable amaview-meteo.timer >/dev/null 2>&1
  sudo systemctl restart amaview-meteo.timer && verde "  amaview-meteo.timer ligado (a cada 5 min)"
}

situacao_meteo() {
  titulo "Estações meteorológicas"
  systemctl is-active --quiet amaview-meteo.timer \
    && verde "  timer ligado" || vermelho "  timer desligado — rode: amaview instalar"
  python3 - <<'PY' 2>/dev/null || amarelo "  sem estacoes.json ainda em /var/cache/amaview-meteo"
import json
from datetime import datetime, timezone
e = json.load(open("/var/cache/amaview-meteo/meteo/v1/estacoes.json"))["estacoes"]
agora = datetime.now(timezone.utc).timestamp() * 1000
for k, nome in (("i", "INMET"), ("m", "METAR")):
    x = [s for s in e if s["k"] == k]
    if x:
        novo = max(s["u"]["ms"] for s in x)
        print(f"  {nome:6} {len(x)} estações · mais nova de {(agora - novo) / 60e3:.0f} min atrás")
PY
  journalctl -u amaview-meteo -n 1 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
  echo "  em disco: $(du -sh /var/cache/amaview-meteo 2>/dev/null | cut -f1)"
}

situacao_fumaca() {
  titulo "Fumaça"
  systemctl is-active --quiet amaview-fumaca.timer \
    && verde "  timer ligado" || vermelho "  timer desligado — rode: amaview instalar"
  python3 - <<'PY' 2>/dev/null || amarelo "  sem índice ainda em /var/cache/amaview-fumaca"
import json
from datetime import datetime, timezone
i = json.load(open("/var/cache/amaview-fumaca/fumaca/v2/indice.json"))
q = i["quadros"]
agora = datetime.now(timezone.utc)
print(f"  {len(q)} quadros nas últimas 48 h (esperados 288)")
if q:
    c = q[-1]["c"]
    t = datetime.strptime(c, "%Y%j%H%M").replace(tzinfo=timezone.utc)
    print(f"  mais novo: {t:%d/%m %H:%M} UTC ({(agora - t).total_seconds() / 60:.0f} min atrás) · {q[-1]['n']} áreas, {q[-1]['km2']} km²")
PY
  journalctl -u amaview-fumaca -n 1 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
  echo "  em disco: $(du -sh /var/cache/amaview-fumaca 2>/dev/null | cut -f1)"
}

certificado() {
  titulo "Certificado dos blocos ($BLOCOS_NOME)"
  command -v certbot >/dev/null \
    || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq certbot >/dev/null
  # Validação pelo nginx da porta 80 (/.well-known); a renovação é do certbot.timer,
  # e o gancho recarrega o nginx com o certificado novo.
  sudo certbot certonly --webroot -w /var/www/html -d "$BLOCOS_NOME" \
    --agree-tos --register-unsafely-without-email --non-interactive \
    --deploy-hook "systemctl reload nginx" || return 1
  gerar_site_blocos && verde "  https://$BLOCOS_NOME/blocos/saude"
}

situacao_blocos() {
  titulo "Blocos"
  systemctl is-active --quiet amaview-blocos \
    && verde "  serviço no ar" || vermelho "  serviço parado — rode: amaview instalar"
  curl -s --max-time 5 http://127.0.0.1:8090/blocos/saude | python3 -c '
import json, sys
s = json.load(sys.stdin)
print(f"  {s["cortes_ultima_hora"]} quadros cortados na última hora ({s["segundos_por_corte"]} s cada)")
print(f"  fila do pré-corte: {s["fila_pre_corte"]} · falhas: {s["falhas"]} · disco livre: {s["disco_livre_gb"]} GB")
if s["ultimo_erro"]: print(f"  último erro: {s["ultimo_erro"]}")
' 2>/dev/null || amarelo "  sem resposta em 127.0.0.1:8090"
  echo "  em disco: $(sudo du -sh /var/cache/amaview-blocos 2>/dev/null | cut -f1)"
  if sudo test -s "$CERT_IP"; then
    verde "  https://$BLOCOS_IP (vence $(sudo openssl x509 -in "$CERT_IP" -noout -enddate | cut -d= -f2))"
  else
    amarelo "  sem certificado do IP — rode: amaview renovar-ip"
  fi
  if sudo test -s "/etc/letsencrypt/live/$BLOCOS_NOME/fullchain.pem"; then
    verde "  https://$BLOCOS_NOME"
  else
    amarelo "  sem HTTPS ainda — rode: amaview certificado"
  fi
}

gravar_token() {
  titulo "Token"
  echo "  Crie um fine-grained PAT em:"
  echo "    https://github.com/settings/tokens?type=beta"
  echo "  Acesso só a AmaView-dados · permissão 'Actions: Read and write'."
  echo
  # -s para não ecoar: o token não entra na tela nem no histórico, e como vai
  # por stdin também não aparece na lista de processos.
  read -rsp "  Cole o token (não aparece na tela): " t
  echo
  t="$(printf '%s' "$t" | tr -d '[:space:]')"
  if [ -z "$t" ]; then vermelho "  nada colado; nada gravado"; return 1; fi

  sudo install -m 600 /dev/null "$TOKEN"
  printf '%s\n' "$t" | sudo tee "$TOKEN" >/dev/null
  unset t
  verde "  gravado em $TOKEN (modo 600, só root lê)"

  echo
  echo "  Testando…"
  if sudo "$DESTINO/agendador/disparar.py" chuva.yml; then
    ligar_timers
  else
    vermelho "  o token não foi aceito — confira a permissão e rode 'amaview token' de novo"
    return 1
  fi
}

# Chaves opcionais da qualidade do ar (PurpleAir e OpenAQ). Pedidas na tela
# sem eco, testadas com uma chamada grátis ANTES de gravar e gravadas 640
# root:amaview-ar — o serviço lê, ninguém mais. A chave nunca vai para a
# linha de comando (vai ao curl pelo stdin, `-H @-`), nem para a tela.
gravar_chave() {
  local fonte="${1:-}" acao="${2:-}" arq teste onde
  case "$fonte" in
    purpleair)
      arq="/etc/amaview/purpleair-key"
      teste="https://api.purpleair.com/v1/keys"
      onde="https://develop.purpleair.com/ (entre com o e-mail; crie uma chave READ)"
      ;;
    openaq)
      arq="/etc/amaview/openaq-key"
      teste="https://api.openaq.org/v3/locations?limit=1"
      onde="https://explore.openaq.org/register (a chave aparece em Account → API Key)"
      ;;
    *)
      echo "uso: amaview chave purpleair|openaq [remover]"
      return 1
      ;;
  esac
  titulo "Chave $fonte"
  if [ "$acao" = "remover" ]; then
    sudo rm -f "$arq" && verde "  $arq apagado; a fonte sai na próxima rodada"
    return 0
  fi
  echo "  Onde conseguir: $onde"
  echo
  read -rsp "  Cole a chave (não aparece na tela): " k
  echo
  k="$(printf '%s' "$k" | tr -d '[:space:]')"
  if [ -z "$k" ]; then vermelho "  nada colado; nada gravado"; return 1; fi

  echo "  Testando (chamada grátis)…"
  local resp codigo corpo
  resp="$(printf 'X-API-Key: %s\n' "$k" | curl -s -m 30 -H @- -w '\n%{http_code}' "$teste")"
  codigo="$(printf '%s' "$resp" | tail -n 1)"
  corpo="$(printf '%s' "$resp" | sed '$d')"
  if [ "$codigo" != "200" ]; then
    unset k
    vermelho "  chave recusada (HTTP $codigo) — nada gravado"
    printf '%s' "$corpo" | head -c 300 | sed 's/^/  /'
    echo
    return 1
  fi
  if ! getent group amaview-ar >/dev/null; then
    vermelho "  o serviço da qualidade do ar não está instalado — rode antes: amaview instalar"
    unset k
    return 1
  fi
  sudo mkdir -p /etc/amaview
  sudo install -m 640 -o root -g amaview-ar /dev/null "$arq"
  printf '%s\n' "$k" | sudo tee "$arq" >/dev/null
  unset k
  verde "  aceita e gravada em $arq (640 root:amaview-ar)"
  if [ "$fonte" = "purpleair" ]; then
    printf '%s' "$corpo" | python3 -c 'import json, sys; print("  tipo da chave:", json.load(sys.stdin).get("api_key_type", "?"))' 2>/dev/null
    sudo cat "$arq" | sed 's/^/X-API-Key: /' | curl -s -m 30 -H @- https://api.purpleair.com/v1/organization | python3 -c 'import json, sys
d = json.load(sys.stdin)
print("  organização:", d.get("organization_name") or "?")
print("  saldo:", format(int(d.get("remaining_points") or 0), ",").replace(",", "."), "pontos")' 2>/dev/null
    echo "  O espelho consulta só os sensores da Amazônia Legal que a UFAC, a RedeAr e"
    echo "  a AirGradient não trazem, de hora em hora, e para abaixo de 50.000 pontos."
    echo "  Intervalo e limite: /etc/amaview/ar.conf (PURPLEAIR_INTERVALO_MIN, PURPLEAIR_SALDO_MIN)."
  fi
  echo "  Rodando o espelho agora…"
  sudo systemctl start amaview-ar.service && situacao_ar
}

frescor() {
  python3 - <<'PY' 2>/dev/null || echo "  não consegui ler o dado publicado"
import json, urllib.request
from datetime import datetime, timezone
base = "https://helvecioneto.github.io/AmaView-dados"
# Limites por produto, em minutos. A sondagem tem horas de idade por natureza:
# roda 4×/dia, e o maior intervalo entre horários é de 9 h.
