#!/usr/bin/env bash
#
# Painel do agendador do AmaView numa linha só.
#
#   amaview              situação (timers, últimas execuções, frescor do dado)
#   amaview instalar     clona/atualiza, instala as unidades e liga os timers
#   amaview token        grava o token (pede na tela, sem eco)
#   amaview disparar [w] dispara um ciclo agora (chuva.yml; ou sondagem.yml)
#   amaview logs [n]     últimas execuções
#   amaview parar        desliga os timers
#   amaview remover      desinstala tudo (menos o token)
#
# O agendamento do GitHub Actions não é confiável — medido: 135 min de
# intervalo médio quando o pedido era 15. Esta máquina é o relógio de verdade.
set -uo pipefail

REPO_URL="https://github.com/helvecioneto/AmaView-dados"
DESTINO="/opt/amaview"
# Uma unidade por workflow. A sondagem entrou depois de passar 12 h sem
# atualizar: dependia só do `schedule` do GitHub, que em 21/09/2026 entregou
# 1 de 2 horários com ~4 h de atraso.
UNIDADES="amaview-chuva amaview-sondagem"
TOKEN="/etc/amaview/token"

verde() { printf '\033[32m%s\033[0m\n' "$*"; }
vermelho() { printf '\033[31m%s\033[0m\n' "$*"; }
amarelo() { printf '\033[33m%s\033[0m\n' "$*"; }
titulo() { printf '\n\033[1m%s\033[0m\n' "$*"; }

timers() { for u in $UNIDADES; do printf '%s.timer ' "$u"; done; }
filtro_journal() { for u in $UNIDADES; do printf -- '-u %s ' "$u"; done; }

# `restart`, e não só `--now`: um timer já ativo não relê a unidade editada.
ligar_timers() {
  for t in $(timers); do
    sudo systemctl enable "$t" >/dev/null 2>&1 && sudo systemctl restart "$t" && verde "  $t ligado"
  done
}

instalar() {
  titulo "Instalando"
  sudo mkdir -p "$DESTINO" /etc/amaview
  if [ -d "$DESTINO/.git" ]; then
    sudo git -C "$DESTINO" pull -q && echo "  repositório atualizado"
  else
    sudo git clone -q "$REPO_URL" "$DESTINO" && echo "  repositório clonado"
  fi
  sudo chmod +x "$DESTINO/agendador/disparar.py"
  for u in $UNIDADES; do
    sudo cp "$DESTINO/agendador/$u.service" "$DESTINO/agendador/$u.timer" /etc/systemd/system/
  done
  sudo systemctl daemon-reload
  echo "  unidades instaladas"

  # Mantém este próprio script em dia junto com o resto.
  sudo install -m 755 "$DESTINO/agendador/amaview" /usr/local/bin/amaview 2>/dev/null \
    && echo "  'amaview' disponível em /usr/local/bin"

  if [ ! -s "$TOKEN" ]; then
    amarelo "  token ausente — rode: amaview token"
    return 0
  fi
  ligar_timers
}

gravar_token() {
  titulo "Token"
  echo "  Crie um fine-grained PAT em:"
  echo "    https://github.com/settings/tokens?type=beta"
  echo "  Acesso só a AmaView-dados · permissão 'Actions: Read and write'."
  echo
  # -s para não ecoar: o token não entra na tela nem no histórico, e como vai
  # por stdin também não aparece na lista de processos.
  read -rsp "  Cole o token (não aparece na tela): " t
  echo
  t="$(printf '%s' "$t" | tr -d '[:space:]')"
  if [ -z "$t" ]; then vermelho "  nada colado; nada gravado"; return 1; fi

  sudo install -m 600 /dev/null "$TOKEN"
  printf '%s\n' "$t" | sudo tee "$TOKEN" >/dev/null
  unset t
  verde "  gravado em $TOKEN (modo 600, só root lê)"

  echo
  echo "  Testando…"
  if sudo "$DESTINO/agendador/disparar.py" chuva.yml; then
    ligar_timers
  else
    vermelho "  o token não foi aceito — confira a permissão e rode 'amaview token' de novo"
    return 1
  fi
}

frescor() {
  python3 - <<'PY' 2>/dev/null || echo "  não consegui ler o dado publicado"
import json, urllib.request
from datetime import datetime, timezone
base = "https://helvecioneto.github.io/AmaView-dados"
# Limites por produto, em minutos. A sondagem tem horas de idade por natureza:
# roda 4×/dia, e o maior intervalo entre horários é de 9 h.
for nome, cam, ok, velho in (("chuva", "cemaden", 45, 720), ("sondagem", "sondagem", 660, 1440)):
    try:
        with urllib.request.urlopen(f"{base}/{cam}/manifest.json", timeout=15) as r:
            m = json.load(r)
        idade = (datetime.now(timezone.utc) - datetime.fromisoformat(m["gerado"].replace("Z", "+00:00")))
        mins = idade.total_seconds() / 60
        marca = "ok" if mins < ok else ("ATRASADO" if mins < velho else "VELHO")
        print(f"  {nome:9} {mins:6.0f} min atrás   {marca}")
    except Exception as e:
        print(f"  {nome:9} falhou: {e}")
PY
}

situacao() {
  titulo "Timers"
  systemctl list-timers $(timers) --no-pager 2>/dev/null | sed -n '/^NEXT/,/^$/p' | sed '/^$/d; s/^/  /'
  for t in $(timers); do
    systemctl is-enabled "$t" >/dev/null 2>&1 || amarelo "  $t desligado — rode: amaview instalar"
  done

  titulo "Token"
  if sudo test -s "$TOKEN" 2>/dev/null; then
    verde "  presente ($(sudo stat -c %a "$TOKEN"))"
  else
    amarelo "  ausente — rode: amaview token"
  fi

  titulo "Últimas execuções"
  journalctl $(filtro_journal) -n 8 --no-pager -o short 2>/dev/null | sed 's/^/  /' || echo "  (sem log ainda)"

  titulo "Dado publicado"
  frescor
  echo
}

case "${1:-status}" in
  instalar | install) instalar ;;
  token) gravar_token ;;
  disparar | run) sudo "$DESTINO/agendador/disparar.py" "${2:-chuva.yml}" ;;
  logs) journalctl $(filtro_journal) -n "${2:-30}" --no-pager ;;
  parar | stop) sudo systemctl disable --now $(timers) && verde "timers desligados" ;;
  remover)
    sudo systemctl disable --now $(timers) 2>/dev/null
    for u in $UNIDADES; do
      sudo rm -f "/etc/systemd/system/$u.service" "/etc/systemd/system/$u.timer"
    done
    sudo systemctl daemon-reload
    verde "removido (o token em $TOKEN foi mantido)"
    ;;
  status | '') situacao ;;
  *)
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
