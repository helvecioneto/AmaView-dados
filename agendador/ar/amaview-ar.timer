[Unit]
Description=Qualidade do ar a cada 5 minutos
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/ar

[Timer]
# Os sensores da rede do Acre publicam a cada ~2 min, mas a API só dá a
# leitura mais recente de cada um: olhar a cada 5 min é o que monta a série.
# O MonitorAr (horário) é lido a cada 15 min e o CAMS (12 em 12 h) só quando
# há rodada nova — o próprio ar.py decide.
OnCalendar=*:0/5
Persistent=true
AccuracySec=10s
Unit=amaview-ar.service

[Install]
WantedBy=timers.target
