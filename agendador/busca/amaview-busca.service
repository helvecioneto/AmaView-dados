[Unit]
Description=Busca em português do AmaView (Jev da TypeSafe, pela OpenRouter)
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/busca
After=network-online.target
Wants=network-online.target

[Service]
# Python da venv (o SDK da TypeSafe vem do pip); o código é o do repositório.
ExecStart=/opt/amaview-busca/venv/bin/python /opt/amaview/agendador/busca/busca.py
User=amaview-busca
Group=amaview-busca
# Chave da OpenRouter: 640 root:amaview-busca (`amaview chave openrouter`).
Environment=BUSCA_CHAVE=/etc/amaview/openrouter-key
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
MemoryMax=512M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
