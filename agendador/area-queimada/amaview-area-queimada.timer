[Unit]
Description=Área atingida pelo fogo (focos do INPE agrupados), uma vez por dia às 3h de Brasília
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/area-queimada

[Timer]
# Às 3h de Brasília quase ninguém usa o AmaView: a rodada (uns 3 min de um
# núcleo na Oracle, quase todo nos 60 dias) não disputa com quem está no site.
# O diário do INPE de ontem ainda cresce até ~12h UTC; a rodada seguinte o
# relê (o arquivo só é dado como fechado depois disso).
OnCalendar=*-*-* 03:00:00 America/Sao_Paulo
Persistent=true
AccuracySec=1min
Unit=amaview-area-queimada.service

[Install]
WantedBy=timers.target
