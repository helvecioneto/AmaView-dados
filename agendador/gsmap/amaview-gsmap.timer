[Unit]
Description=Chuva do GSMaP_NOW a cada 5 minutos
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/gsmap

[Timer]
# A JAXA publica a cada 30 min, perto do fim de cada meia hora; olhar a cada
# 5 min põe o horário novo no ar até 5 min depois. Cada olhada sem novidade é
# uma listagem do latest/ (alguns KB).
OnCalendar=*:0/5
Persistent=true
AccuracySec=20s
Unit=amaview-gsmap.service

[Install]
WantedBy=timers.target
