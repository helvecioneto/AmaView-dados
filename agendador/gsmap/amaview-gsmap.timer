[Unit]
Description=Chuva do GSMaP_NOW a cada 5 minutos
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/gsmap

[Timer]
# A JAXA publica cada hora 1 min depois de ela terminar (16:00–17:00 às
# 17:01, medido em 23/10/2026). Olhar às :02, :07… põe a hora nova no ar ~2 min
# depois (a gravação leva ~11 s). Cada olhada sem novidade é uma listagem do
# latest/ (alguns KB).
OnCalendar=*:2/5
Persistent=true
AccuracySec=20s
Unit=amaview-gsmap.service

[Install]
WantedBy=timers.target
