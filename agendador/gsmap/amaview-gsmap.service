[Unit]
Description=Chuva por satélite para o AmaView (GSMaP_NOW da JAXA, recorte do setor NSA)
Documentation=https://github.com/helvecioneto/AmaView-dados/tree/main/agendador/gsmap
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/amaview/agendador/gsmap/gsmap.py
User=amaview-gsmap
Group=amaview-gsmap
# /var/cache/amaview-gsmap, legível pelo nginx (www-data): pastas 755, arquivos 644.
CacheDirectory=amaview-gsmap
CacheDirectoryMode=0755
UMask=0022
# A chave do servidor da JAXA (SFTP) fica em $HOME/.ssh/known_hosts, gravada
# pelo `amaview instalar`; o curl recusa servidor desconhecido.
StateDirectory=amaview-gsmap
StateDirectoryMode=0750
Environment=HOME=/var/lib/amaview-gsmap
Environment=GSMAP_RAIZ=/var/cache/amaview-gsmap
Environment=PYTHONUNBUFFERED=1
# GSMAP_PROTOCOLO=ftp, se a conta não entrar por SFTP (o `amaview chave gsmap` decide).
EnvironmentFile=-/etc/amaview/gsmap.conf
# Preenchimento das 48 h: ~100 arquivos de ~800 KB, em rodadas de 24.
TimeoutStartSec=15min
Nice=10
MemoryMax=1G

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
